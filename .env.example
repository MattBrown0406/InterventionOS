EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Supabase Edge Function secret; set this in Supabase, not Expo/frontend code.
# Generate with: openssl rand -hex 32
INTERVENTIONOS_AGENT_TOKEN=do_not_put_real_token_in_git
INTERVENTIONOS_OWNER_USER_ID=00000000-0000-0000-0000-000000000000
